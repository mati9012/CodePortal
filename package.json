{
  "name": "codeportal",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose -f docker-compose.infra.yml up -d",
    "db:down": "docker compose -f docker-compose.infra.yml down",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down"
  },
  "engines": {
    "node": ">=22"
  }
}
