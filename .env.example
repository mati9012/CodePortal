# ── Lokalny development (pnpm dev) ───────────────────────────────────────────
# API (apps/api/.env)
DATABASE_URL=postgresql://codeportal:codeportal@localhost:5432/codeportal
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=codeportal
S3_SECRET_KEY=codeportal-dev
S3_BUCKET=codeportal
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Logowanie (Better Auth). Sekret: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=
# Bez SMTP_URL linki z e-maili (weryfikacja, reset hasła) są wypisywane w logu API.
# SMTP_URL=smtps://user:haslo@smtp.example.com:465
# MAIL_FROM=CodePortal <no-reply@example.com>

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Docker Compose (.env w katalogu głównym, wszystko opcjonalne) ────────────
# POSTGRES_USER=codeportal
# POSTGRES_PASSWORD=codeportal
# POSTGRES_DB=codeportal
# S3_ACCESS_KEY=codeportal
# S3_SECRET_KEY=codeportal-dev
# S3_BUCKET=codeportal
# Adresy widziane z przeglądarki — zmień, gdy otwierasz aplikację z innego komputera
# w sieci (np. http://192.168.1.20:3000 i http://192.168.1.20:4000), potem --build.
# PUBLIC_WEB_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:4000
# Wymagane: sekret sesji logowania (openssl rand -base64 32)
# BETTER_AUTH_SECRET=
# Wspólna domena frontu i API, gdy są na subdomenach (np. mkucio.pl dla
# codeportal.mkucio.pl + api.mkucio.pl) — wtedy ciasteczko logowania widzą oba.
# COOKIE_DOMAIN=
# SMTP_URL=
# MAIL_FROM=
# WEB_PORT=3000
# API_PORT=4000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# S3_PORT=8333
